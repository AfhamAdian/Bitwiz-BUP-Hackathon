# Fallback chain, tried left to right. A provider may repeat to use its next API key:
# "groq,groq,..." sends the first attempt with GROQ_API_KEY1 and the retry with GROQ_API_KEY2.
# Any provider omitted here is still used as a last resort.
PROVIDER_ORDER=groq,groq,gemini,omniroute

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# GROQ_API_KEY is the single-key fallback used only if KEY1/KEY2 are both blank.
# Leave KEY2 blank to reuse KEY1. Note: Groq TPM limits are per model per ORG, so a second
# key from the same account shares the same quota - use different models instead.
GROQ_API_KEY=
GROQ_API_KEY1=
GROQ_API_KEY2=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL1=openai/gpt-oss-120b
GROQ_MODEL2=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# Per-attempt LLM call budget. Keep LLM_TIMEOUT_SECONDS comfortably under the
# judge's 30s per-request limit so a slow provider fails over instead of timing out.
LLM_TIMEOUT_SECONDS=30
LLM_CONNECT_TIMEOUT_SECONDS=5
